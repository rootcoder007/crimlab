cff-version: 1.2.0
message: "To cite crimlab in publications use the reference below."
type: software
title: "crimlab: Statistical Toolkit for Criminology and Sociolegal Research"
authors:
  - family-names: Ruhela
    given-names: Vansh Singh
    orcid: "https://orcid.org/0009-0004-1750-3592"
license: Apache-2.0 WITH LLVM-exception
repository-code: "https://github.com/rootcoder007/crimlab"
url: "https://crimlab.dev"
abstract: >-
  Statistical methods for courts, corrections, policing, forensic science
  and sociolegal research, computed in a compiled C++17 core with bindings
  for R, Python, the command line, Go, Rust, Java and JavaScript.
keywords:
  - statistics
  - criminology
  - sociolegal research
  - forensic science
  - policing
  - courts
  - corrections
  - sentencing
  - disparity
  - likelihood ratio
  - causal inference
  - spatial statistics
