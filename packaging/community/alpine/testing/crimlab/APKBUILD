pkgname=crimlab
pkgver=0.0.3
pkgrel=0
pkgdesc="Statistical toolkit for criminology and sociolegal research"
url="https://crimlab.dev/"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
subpackages="$pkgname-dev $pkgname-doc $pkgname-libs"
source="https://github.com/rootcoder007/crimlab/releases/download/v$pkgver/crimlab-$pkgver.tar.gz"

build() {
	make -C cli WERROR= CXXFLAGS="$CXXFLAGS"
}

check() {
	make -C cli WERROR= CXXFLAGS="$CXXFLAGS" check
}

package() {
	make -C cli WERROR= CXXFLAGS="$CXXFLAGS" DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 LICENSE NOTICE -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="
